# NVIDIA NIM (API key from https://build.nvidia.com)
LLM_API_KEY=nvapi-your-api-key-here
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#
# == SPEED TIERS (on NIM free tier) ==
#  FASTEST (<10s/call ideal):  meta/llama-3.1-8b-instruct  |  microsoft/phi-3-mini-128k-instruct  |  mistralai/mistral-7b-instruct-v0.3
#  FAST-BALANCED (~10-20s):  mistralai/codestral-22b-instruct-v0.1
#  SLOW-STRONG (1-3 min):    meta/llama-3.1-70b-instruct  |  nvidia/llama-3.3-nemotron-super-49b-v1  |  nvidia/llama-3.1-nemotron-ultra-253b-v1
#
# For quick testing during interviews, use the FASTEST tier:
LLM_MODEL=meta/llama-3.1-8b-instruct

# OpenAI (uncomment to use):
# LLM_API_KEY=sk-your-key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Tuning (optional — defaults shown; uncomment to override):
# LLM_TIMEOUT_SECONDS=120       # max wait per LLM call (fail fast if hung)
# MAX_PLAN_TOKENS=1500          # planner max output — short plans are fast plans
# MAX_CODE_TOKENS=4096          # coder max output (6 files × ~400 tokens each)
# MAX_SUMMARY_TOKENS=600        # summarizer max output
# MAX_CONTEXT_TOKENS=120000
# MAX_RETRIES=2
# LLM_TEMPERATURE=0.2

